# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Kaggle API credentials for dataset search, ingestion and remote compute execution
KAGGLE_USERNAME=MY_KAGGLE_USERNAME
KAGGLE_KEY=MY_KAGGLE_KEY

# AWS S3 Cloud Storage & Compute sync
AWS_ACCESS_KEY_ID=MY_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=MY_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=concordance-capsules

# Science Paper API Keys (Optional; high-rate-limit access for PubMed/NCBI & Semantic Scholar)
NCBI_API_KEY=MY_NCBI_API_KEY
SEMANTIC_SCHOLAR_API_KEY=MY_SEMANTIC_SCHOLAR_KEY
