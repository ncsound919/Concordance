<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only by default. Cleartext is permitted only for the emulator's host
  loopback aliases, which is the documented local-development path. A physical
  device should use HTTPS for the self-hosted agent (or add its exact host to a
  debug-only variant of this file).
-->
<network-security-config>
    <!-- Release traffic is HTTPS-only. Loopback cleartext for local development
         lives in app/src/debug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
