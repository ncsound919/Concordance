<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the embedded llama.cpp server alive while the app is in the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- WorkManager runs slow-mode research as a foreground worker. Android 14+ refuses a
         foreground service with no declared type, so WorkManager's own foreground service
         is given the dataSync type and the matching permission is requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- On-device dictation for the agent screen. Audio is transcribed locally and is
         never uploaded: see voice/OnDeviceSpeechRecognizer.kt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Photos taken for OCR are written to the app cache and handed to the camera app
             through this provider; nothing is stored in shared storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Tasker / automation trigger receiver (see integration.tasker.TaskerBridge).
             Exported so external automation apps can send the declared broadcasts; the
             actions are app-specific and carry no PHI. -->
        <receiver
            android:name="com.example.concordance.integration.tasker.TaskerTriggerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="concordance.action.RUN_LEARNING_ROUND" />
                <action android:name="concordance.action.CHECK_AUTO_TRIGGER" />
                <action android:name="concordance.action.RE_ADJUDICATE" />
                <action android:name="concordance.action.SYNC_CAPSULES" />
            </intent-filter>
        </receiver>

        <!-- Embedded llama.cpp server. Runs as a foreground service so Android does not
             freeze the CPU while a local model is streaming. Weights are never bundled in
             the APK; the executable is shipped as libllamaserver.so (see LocalLlmService). -->
        <service
            android:name="com.example.concordance.local.LocalLlmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device language model server alive while the app is in use" />
        </service>

        <!-- High-power research: delegates experiments to cloud compute. -->
        <service
            android:name="com.example.concordance.autonomy.HighPowerResearchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs high-power research experiments with compute delegation" />
        </service>

        <!-- WorkManager's foreground service. The library declares no foreground service
             type, which makes startForeground() throw InvalidForegroundServiceTypeException
             on Android 14+ (targetSdk 36). Declaring dataSync here matches the type the
             workers pass in their ForegroundInfo. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
